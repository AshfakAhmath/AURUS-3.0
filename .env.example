# Gemini API configuration for core AI brain
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VOICE=Puck

# Optional cloud dialogue. Core robot behavior works without this key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Voice Recognition settings (Porcupine Access Key)
PORCUPINE_ACCESS_KEY=

# Local speech and TTS models.
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
MIC_INDEX=
AURUS_RECORD_SECONDS=6.0

# Motor configurations
MOTOR_SPEED_MULTIPLIER=1.0

# Wake phrase remains gated until a controlled 20-trial test is recorded.
AURUS_WAKE_ENABLED=false
WAKE_TEST_PASSES=0
WAKE_TEST_TOTAL=0

AURUS_HOST=0.0.0.0
AURUS_PORT=5000
AURUS_SESSION_SECRET=replace-for-non-local-deployment
