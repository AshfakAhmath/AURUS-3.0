# Optional Groq access is retained only for the separate dashboard MCP agent.
GROQ_API_KEY=
GROQ_AGENT_MODEL=llama-3.3-70b-versatile

# Free local conversational model. LOCAL_LLM_SERVER_URL can instead point to
# a locally running llama.cpp-compatible /v1 API; no API key is required.
LOCAL_LLM_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_LLM_SERVER_URL=
LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct
LOCAL_LLM_CONTEXT=2048
LOCAL_LLM_MAX_TOKENS=96
LOCAL_LLM_TIMEOUT=20
LOCAL_LLM_THREADS=4

# Fully local wake-word, endpointing, speech recognition, and TTS.
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
KWS_MODEL_PATH=models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01
KWS_KEYWORDS_PATH=models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/aurus_keywords.txt
VAD_MODEL_PATH=models/silero_vad.onnx
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
MIC_INDEX=
# Optional ALSA override used when PortAudio/PulseAudio cannot expose the USB mic.
# Example for the device shown as "card 3: Device" by `arecord -l`:
ALSA_CAPTURE_DEVICE=
AURUS_MAX_UTTERANCE_SECONDS=10.0
AURUS_SPEECH_START_TIMEOUT=4.0
AURUS_WAKE_ENABLED=true

# Motor configurations
MOTOR_SPEED_MULTIPLIER=1.0

AURUS_HOST=0.0.0.0
AURUS_PORT=5000
AURUS_SESSION_SECRET=replace-for-non-local-deployment
