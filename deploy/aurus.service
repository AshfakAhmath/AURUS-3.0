[Unit]
Description=AURUS Evaluation Edition
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/aurus
EnvironmentFile=-/home/pi/aurus/.env
ExecStart=/home/pi/aurus/.venv/bin/python /home/pi/aurus/run.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
